{
  "name": "@dimensi/yazio",
  "version": "2.0.0",
  "type": "module",
  "description": "Lightweight JS/TS client for the YAZIO API. Track calories, log items, and build integrations easily.",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "bun --watch test",
    "bundle": "tsup src/index.ts src/auth.ts src/api.ts --minify --dts --format esm,cjs --splitting --clean",
    "test": "bun test tests/consumed-time.test.ts tests/meal-images.test.ts"
  },
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./api": {
      "import": { "types": "./dist/api.d.ts", "default": "./dist/api.js" },
      "require": { "types": "./dist/api.d.cts", "default": "./dist/api.cjs" }
    },
    "./auth": {
      "import": { "types": "./dist/auth.d.ts", "default": "./dist/auth.js" },
      "require": { "types": "./dist/auth.d.cts", "default": "./dist/auth.cjs" }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.0.2",
    "typescript": "^5.0.0"
  }
}
